---
title: Modelo Relacional — Sistema de Guardado
---
classDiagram
    class SaveSlots {
        <<PK>> id : INTEGER
        slot_name : TEXT NOT NULL
        player_name : TEXT NOT NULL
        created_at : TEXT NOT NULL
        last_saved : TEXT NOT NULL
        play_time : REAL DEFAULT 0
    }

    class Players {
        <<PK>> id : INTEGER
        <<FK>> slot_id → SaveSlots.id
        name : TEXT NOT NULL
        pos_x : REAL DEFAULT 0
        pos_y : REAL DEFAULT 0
        pos_z : REAL DEFAULT 0
    }

    class Farms {
        <<PK>> id : INTEGER
        <<FK>> slot_id → SaveSlots.id
        farm_name : TEXT NOT NULL
        size_x : INTEGER DEFAULT 10
        size_y : INTEGER DEFAULT 10
        unlocked : INTEGER DEFAULT 1
    }

    class FarmTiles {
        <<PK>> id : INTEGER
        <<FK>> farm_id → Farms.id
        tile_x : INTEGER NOT NULL
        tile_y : INTEGER NOT NULL
        soil_state : TEXT DEFAULT dry
        crop_id : TEXT DEFAULT empty
        growth_stage : INTEGER DEFAULT 0
        days_planted : INTEGER DEFAULT 0
    }

    class Inventory {
        <<PK>> id : INTEGER
        <<FK>> slot_id → SaveSlots.id
        item_id : TEXT NOT NULL
        item_name : TEXT NOT NULL
        quantity : INTEGER DEFAULT 1
        slot_index : INTEGER DEFAULT -1
        item_data : TEXT
    }

    SaveSlots "1" --> "0..*" Players    : ON DELETE CASCADE
    SaveSlots "1" --> "0..*" Farms      : ON DELETE CASCADE
    SaveSlots "1" --> "0..*" Inventory  : ON DELETE CASCADE
    Farms     "1" --> "0..*" FarmTiles  : ON DELETE CASCADE